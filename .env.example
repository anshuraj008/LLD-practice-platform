# Database connection string (defaults to local SQLite database in development)
DATABASE_URL=file:./lld_platform.db

# Google Gemini API Key (obtainable from Google AI Studio - https://aistudio.google.com/)
# Optional for local offline runs; if not set, platform automatically uses high-fidelity Deterministic Mock Evaluator
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development
